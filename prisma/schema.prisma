generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_MASTER
  SUPER_ADMIN
  MASTER
  CLIENT
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  passwordHash   String
  role           Role
  parentUserId   String?
  parent         User?    @relation("UserHierarchy", fields: [parentUserId], references: [id])
  children       User[]   @relation("UserHierarchy")
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([parentUserId])
  @@index([organizationId])
  @@index([role])
  @@map("users")
}
