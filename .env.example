# Copy to .env and adjust. DATABASE_URL is optional for local/dev:
# omit it to run against in-memory stores (enough for S1/S2).
# Set it to use PostgreSQL (source of truth) via Prisma.

DATABASE_URL="postgresql://wagering:wagering@localhost:5432/wagering?schema=public"
JWT_SECRET="change-me-in-production"
PORT=3000
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
BOOTSTRAP_USERNAME="root"
BOOTSTRAP_PASSWORD="changeme"
BOOTSTRAP_ORG_ID="org-local"
